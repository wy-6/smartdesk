# ============================================================
# SmartDesk 环境变量模板
#
# 用法：
#   cp .env.example .env     # 复制一份
#   然后按需修改 .env
#
# 重要：.env 已经在 .gitignore 里，绝不会被提交。
#       这个 .env.example 是模板，可以提交。
# ============================================================

# ---------------- 数据库 ----------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=smartdesk
MYSQL_USER=root
# 改成你自己的密码
MYSQL_PASSWORD=change_me

# ---------------- Redis ----------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Redis 没设密码就留空
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---------------- JWT ----------------
# 生产环境必须替换！生成方式：
#   openssl rand -base64 48
#   或  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-key-must-be-changed-in-production-0123456789
# 令牌有效期（秒），默认 2 小时
JWT_EXPIRATION=7200

# ---------------- 服务端口 ----------------
# 注意：本机 8080 可能被 WorkBuddy 占用，建议用 18080
SERVER_PORT=18080

# ---------------- 日志级别 ----------------
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG

# ---------------- Spring AI（Week3）----------------
# Provider 选择：mock（离线，默认）| openai（任何 OpenAI 兼容协议的服务）
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.3
AI_REQUEST_TIMEOUT=20s
AI_MAX_ATTEMPTS=3
AI_RETRY_BASE_MILLIS=300
# 真实模型：只填 Key 和 base-url，业务代码零改动
OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1

# ---------------- Agent 工具调用（Week4）----------------
# 这四个是"刹车"，不是性能参数。调大之前先想清楚为什么
AI_MAX_ROUNDS=4
AI_MAX_TOOL_CALLS=5
AI_TOOL_TIMEOUT=60s
# 待确认草稿存活时间，过期后确认接口返回 404
AI_CONFIRM_TTL=5m
AI_MAX_HISTORY=20
AI_DUPLICATE_THRESHOLD=3

# ---------------- RAG 知识库（Week5）----------------
# 切片参数必须可配置：不同文档类型要不同策略，且要用评测集量化对比
RAG_ENABLED=true
RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=80
RAG_MIN_CHUNK_SIZE=40
RAG_TOP_K=5
RAG_MAX_TOP_K=20
# 相似度阈值：低于它就不返回。宁可说"没查到"，也不给模型喂噪音
RAG_SIMILARITY_THRESHOLD=0.05
RAG_MAX_DOC_CHARS=100000
RAG_MAX_CHUNKS_PER_DOC=50
# 嵌入模型单独配置（跟聊天模型是两套）：
# mock —— 离线确定性哈希嵌入，无需 Key，测试与 CI 都用它
# openai —— 兼容 /v1/embeddings 的服务（百炼 text-embedding-v3 / OpenAI）
#           注意：DeepSeek 没有 embedding 接口，用它的 Key 时这里保持 mock
RAG_EMBEDDING_PROVIDER=mock
RAG_EMBEDDING_MODEL=text-embedding-v3
RAG_EMBEDDING_DIMENSIONS=256
