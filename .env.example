# ============================================================
# SmartDesk 环境变量模板
#
# 用法：
#   cp .env.example .env     # 复制一份
#   然后按需修改 .env
#
# 重要：.env 已经在 .gitignore 里，绝不会被提交。
#       这个 .env.example 是模板，可以提交。
# ============================================================

# ---------------- 数据库 ----------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=smartdesk
MYSQL_USER=root
# 改成你自己的密码
MYSQL_PASSWORD=change_me

# ---------------- Redis ----------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Redis 没设密码就留空
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---------------- JWT ----------------
# 生产环境必须替换！生成方式：
#   openssl rand -base64 48
#   或  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-key-must-be-changed-in-production-0123456789
# 令牌有效期（秒），默认 2 小时
JWT_EXPIRATION=7200

# ---------------- 服务端口 ----------------
# 注意：本机 8080 可能被 WorkBuddy 占用，建议用 18080
SERVER_PORT=18080

# ---------------- 日志级别 ----------------
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG

# ---------------- Spring AI（Week3）----------------
# Provider 选择：mock（离线，默认）| openai（任何 OpenAI 兼容协议的服务）
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.3
AI_REQUEST_TIMEOUT=20s
AI_MAX_ATTEMPTS=3
AI_RETRY_BASE_MILLIS=300
# 真实模型：只填 Key 和 base-url，业务代码零改动
OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1

# ---------------- Agent 工具调用（Week4）----------------
# 这四个是"刹车"，不是性能参数。调大之前先想清楚为什么
AI_MAX_ROUNDS=4
AI_MAX_TOOL_CALLS=5
AI_TOOL_TIMEOUT=60s
# 待确认草稿存活时间，过期后确认接口返回 404
AI_CONFIRM_TTL=5m
AI_MAX_HISTORY=20
AI_DUPLICATE_THRESHOLD=3
